---
import { getCollection } from "astro:content";
import Reading from "../../layouts/Reading.astro";

const pieces = (await getCollection("journal", (e) => e.data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const year = (d: Date) => d.getUTCFullYear();
const day = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", timeZone: "UTC" });

// Grouped by year so the list has a spine. A flat run of dates reads as a feed.
const years = [...new Set(pieces.map((p) => year(p.data.date)))];
---

<Reading
  title="Journal"
  kind="index"
  standfirst="Notes on drawing maps, building interfaces, and the things that only become clear once they're written down."
  documentTitle="Journal — Eric Wang Design"
>
  {
    pieces.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      years.map((y) => (
        <section class="year">
          <p class="year-mark">{y}</p>
          <ul class="list bare">
            {pieces
              .filter((p) => year(p.data.date) === y)
              .map((p) => (
                <li>
                  <a href={`/journal/${p.id}/`}>
                    <time datetime={p.data.date.toISOString().slice(0, 10)}>
                      {day(p.data.date)}
                    </time>
                    <span class="t">{p.data.title}</span>
                    <span class="s">{p.data.standfirst}</span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    )
  }
</Reading>

<style is:inline>
  .year { margin-bottom: 64px; }
  .year:last-child { margin-bottom: 0; }

  .year-mark {
    margin: 0 0 20px;
    color: #6e6e6e;
    font-size: 11px;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .list li { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }

  /* The date is a fixed column on the left so the titles line up as a stack —
     the same shape as the work rows on the homepage. */
  .list a {
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 0 20px;
    padding: 20px 0;
    text-decoration: none;
  }
  .list time {
    color: #6e6e6e;
    font-size: 13px;
    line-height: 1.62;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .list .t {
    color: #e6e6e6;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.022em;
    transition: color 120ms linear;
  }
  .list .s {
    grid-column: 2;
    margin-top: 6px;
    color: #6e6e6e;
    font-size: 14.5px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .list a:hover .t { color: #ffffff; }
  .list a:focus-visible { outline: 1px solid #999999; outline-offset: 4px; }

  @media (max-width: 640px) {
    .list a { grid-template-columns: 1fr; gap: 4px; }
    .list .s { grid-column: 1; }
    .list .t { font-size: 18px; }
  }
</style>
