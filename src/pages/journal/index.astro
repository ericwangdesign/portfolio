---
// Journal — temporarily a work-in-progress placeholder.
// The full canvas journal is preserved in git history (and in ./[slug].astro
// / src/data/journal.ts). Restore this file from git when the journal is ready
// to publish.
import Analytics from "../../components/Analytics.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Journal — Coming soon — Eric Wang Design</title>
    <meta name="description" content="The journal is a work in progress." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon-lightbg.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap"
      rel="stylesheet"
    />
    <Analytics piece="journal" />
  </head>
  <body>
    <main class="wip">
      <a class="home-link" href="/">Eric Wang Design</a>
      <div class="center">
        <p class="eyebrow">Journal</p>
        <h1>A work in progress.</h1>
        <p class="note">
          I'm still building this out. Come back a little later.
        </p>
        <a class="back" href="/">← Back to home</a>
      </div>
    </main>

    <style is:global>
      :root {
        --ink: #17120d;
        --muted: #6c6258;
        --desk: #e7d8bd;
        --desk-deep: #c5aa7f;
        --serif: "Spectral", Georgia, "Times New Roman", serif;
        --sans: "General Sans", "Inter", system-ui, sans-serif;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100svh;
        color: var(--ink);
        background:
          linear-gradient(120deg, rgba(255,255,255,0.36), transparent 34%),
          radial-gradient(circle at 20% 10%, rgba(255, 122, 89, 0.22), transparent 28%),
          radial-gradient(circle at 80% 20%, rgba(47, 127, 117, 0.18), transparent 30%),
          linear-gradient(135deg, var(--desk), var(--desk-deep));
        font-family: var(--serif);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .wip {
        position: relative;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 32px;
      }

      .home-link {
        position: fixed;
        top: 28px;
        left: 32px;
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
      }

      .home-link:hover { opacity: 0.62; }

      .center {
        text-align: center;
        max-width: 520px;
      }

      .eyebrow {
        margin: 0 0 12px;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      h1 {
        margin: 0;
        font-size: clamp(40px, 8vw, 68px);
        font-weight: 300;
        line-height: 1.02;
      }

      .note {
        margin: 20px 0 0;
        font-size: 19px;
        line-height: 1.4;
        color: var(--muted);
      }

      .back {
        display: inline-block;
        margin-top: 32px;
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid rgba(23, 18, 13, 0.3);
        padding-bottom: 2px;
      }

      .back:hover { opacity: 0.62; }
    </style>
  </body>
</html>
