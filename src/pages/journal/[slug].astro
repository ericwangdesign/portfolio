---
import { getCollection, render } from "astro:content";
import Reading from "../../layouts/Reading.astro";

export async function getStaticPaths() {
  const pieces = (await getCollection("journal", (e) => e.data.published)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return pieces.map((entry, i) => ({
    params: { slug: entry.id },
    // Newest first, so "next" going down the list is the piece before it.
    props: { entry, pieces, older: pieces[i + 1] },
  }));
}

const { entry, pieces, older } = Astro.props;
const { Content, headings } = await render(entry);

const index = pieces.map((p) => ({
  slug: p.id,
  title: p.data.title,
  date: p.data.date,
}));
---

<Reading
  title={entry.data.title}
  kind={entry.data.kind}
  date={entry.data.date}
  standfirst={entry.data.standfirst}
  toc={headings}
  pieces={index}
  current={entry.id}
>
  <Content />

  <Fragment slot="after">
    {
      older && (
        <a class="onward" href={`/journal/${older.id}/`}>
          <span>Older</span>
          <strong>{older.data.title}</strong>
        </a>
      )
    }
  </Fragment>
</Reading>

<style is:inline>
  /* The one thing after the writing. Not a grid of cards — a single door out,
     in the direction you were already going. */
  .onward {
    display: block;
    margin-top: 96px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }
  .onward span {
    display: block;
    color: #6e6e6e;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .onward strong {
    display: block;
    margin-top: 8px;
    color: #cccccc;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.022em;
    transition: color 120ms linear;
  }
  .onward:hover strong { color: #ffffff; }
  .onward:focus-visible { outline: 1px solid #999999; outline-offset: 4px; }
</style>
