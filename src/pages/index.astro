---
// Eric Wang — portfolio landing. One line, centered, Geist 16.
// The full page (work, experiments, window light) is in git history before this commit.
import Analytics from "../components/Analytics.astro";

const canonical = "https://www.ericwangdesign.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eric Wang Design</title>
    <meta name="description" content="Eric Wang is a Designer at Google Maps." />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eric Wang" />
    <meta property="og:title" content="Eric Wang Design" />
    <meta property="og:description" content="Eric Wang is a Designer at Google Maps." />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0f0f0f" />
    <link rel="icon" type="image/png" href="/favicon-darkbg.png" />
    <link rel="apple-touch-icon" href="/favicon-darkbg.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-latin-wght-normal.woff2"
      crossorigin
    />
    <Analytics piece="home" />
    <script is:inline>
      // Theme, before anything paints. Dark by default; the last pick (shared with the
      // vault and studio through the .ericwangdesign.com cookie) still wins.
      (() => {
        let mode = "dark";
        try {
          let c = (document.cookie.match(/(?:^|; )theme=(light|dark)/) || [])[1];
          if (!c) c = localStorage.getItem("theme");
          if (c === "light") mode = "light";
        } catch (e) {}
        document.documentElement.dataset.mode = mode;
      })();
    </script>
    <style is:global>
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-display: swap;
        font-weight: 400 500;
        src: url("/fonts/geist-latin-wght-normal.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
          U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      :root {
        --bg: #0f0f0f;
        --ink: #ffffff;
      }
      :root[data-mode="light"] {
        --bg: #f2f2f2;
        --ink: #0f0f0f;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--bg);
        color: var(--ink);
      }

      body {
        display: grid;
        place-items: center;
        min-height: 100dvh;
        padding: 0 16px;
        box-sizing: border-box;
        font-family: "Geist", system-ui, -apple-system, sans-serif;
        font-size: 16px;
        line-height: 1.4;
        letter-spacing: -0.01em;
        text-align: center;
        -webkit-font-smoothing: antialiased;
      }

      p {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <p>Eric Wang is a Designer at Google Maps.</p>
    </main>
  </body>
</html>
