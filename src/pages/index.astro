---
// Eric Wang — portfolio landing.
// Built from Figma "Home" (file iowWbGxgrpryC9s62qGWGY, node 63:3):
// 640px column, Geist 14/1.3 at -0.01em, #0f0f0f ground, #1a1a1a cards.
import Analytics from "../components/Analytics.astro";
import {
  workGroups,
  experimentColumns,
  footerQuote,
  footerLinks,
} from "../data/site";

// The entrance animation that ships. Change this one string to lock a choice in.
const DEFAULT_ANIM = "signature";

// The handle resolves letter by letter in dispersed order — the same
// bit-reversal an ordered-dither matrix uses to decide what lands first.
const HANDLE = "@ericwangdesign";
const HANDLE_URL = "https://x.com/ericwangdesign";

// The brush face for the 旭飞 in the footer. Swap this one string to change it:
//   "Ma Shan Zheng"    马善政   brush 行楷, upright, most legible small
//   "Zhi Mang Xing"    智莽行书 true 行书, flowing, thinner
//   "Long Cang"        龙藏     handwritten brush, loose
//   "Liu Jian Mao Cao" 柳建毛草 草书, most cursive  ← current
const CJK_FONT = "Liu Jian Mao Cao";
// Only the glyphs actually used are fetched (&text=), so this costs ~2KB.
const cjkInSignature = [...new Set(footerQuote.match(/[\u4e00-\u9fff]/g) ?? [])].join("");
const CJK_HREF =
  `https://fonts.googleapis.com/css2?family=${CJK_FONT.replace(/ /g, "+")}` +
  `&text=${encodeURIComponent(cjkInSignature)}&display=swap`;
// Social scrapers won't resolve a relative og:image, and several refuse a
// relative canonical outright, so both are built against `site` from the Astro
// config rather than written as paths.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const handleChars = [...HANDLE];
const bitrev = (x: number, bits: number) => {
  let r = 0;
  for (let i = 0; i < bits; i++) r = (r << 1) | ((x >> i) & 1);
  return r;
};
const bits = Math.max(1, Math.ceil(Math.log2(handleChars.length || 2)));
const dispersed = handleChars
  .map((_, i) => i)
  .sort((a, b) => bitrev(a, bits) - bitrev(b, bits) || a - b);
// stepOf[charIndex] = which beat of the sequence that letter arrives on
const stepOf: number[] = [];
dispersed.forEach((charIndex, beat) => (stepOf[charIndex] = beat));

// The tuner is kept, but hidden. It only exists locally, and even there it stays
// closed until you ask for it with ?dev in the URL or the ⌥D shortcut.
const showPanel = import.meta.env.DEV;
// The day page colour (--bg under data-mode="light"), without the hash. A live
// tile that draws its own ground is handed this so it sits on the page.
const DAY_BG = "f2f2f2";
const NIGHT_BG = "0f0f0f";

const ANIMS = [
  { id: "signature", label: "Signature", note: "name and bio, one continuous entrance" },
  { id: "fade-up", label: "Fade up", note: "rises 8px, staggered" },
  { id: "blur-up", label: "Blur up", note: "blur 8px + rise" },
  { id: "cascade", label: "Cascade", note: "line by line, fast" },
  { id: "progressive", label: "Progressive", note: "by hierarchy, not order" },
  { id: "map-settle", label: "Map settle", note: "column eases out of a zoom" },
  { id: "ink-bleed", label: "Ink bleed", note: "wipes down like ink" },
  { id: "dither", label: "Dither resolve", note: "quantized, 6 steps" },
  { id: "hairline", label: "Hairline draw", note: "rules draw, then text" },
  { id: "tiles-first", label: "Tiles first", note: "work lands before words" },
  { id: "type-settle", label: "Type settle", note: "tracking tightens in" },
];

// Reveal bookkeeping: --i is document order, --t is hierarchy tier,
// --ci is card order, --b is the beat the element lands on.
//
// The stagger used to be metronomic — one beat per element, so the 64px of air
// before "Work" arrived on the same tick as the 12px between two bio lines, and
// the page read as a single undifferentiated list. A beat is now a distance:
// every element costs one beat for itself plus a beat for each PX_PER_BEAT of
// blank space above it, so the reveal breathes wherever the layout does.
const PX_PER_BEAT = 16;

/** Mirrors the gaps in the CSS below — the two have to be changed together. */
const GAP = {
  tight: 0, // .rows — work rows sit flush against each other
  line: 16, // .bio, .section, .group — one line of air
  block: 24, // .intro, and label-to-company (16 + 8 of padding)
  group: 34, // company to company (8 + 16 + 10)
  section: 72, // .stack — intro, Work, Experiments, footer
};

// The masonry is a second axis: vertical distance across two columns, not the
// rhythm of the flow. Read at the same rate it would swamp the section breaks,
// so the grid is scaled to land as one settle rather than a fifth sequence.
const PX_PER_CARD_BEAT = 96;
const CARD_GAP = 8;

let _i = 0;
let _ci = 0;
let _beats = 0;
let _started = false;
let _gridStart: number | null = null;
const beatsAttr = (b: number) => `--b:${Math.round(b * 100) / 100}`;

/** The name and the handle carry their own timing; they sit outside the beat. */
const rvHead = () => `--i:${_i++};--t:1`;

const rv = (tier: number, gap: number = GAP.line) => {
  if (_started) _beats += 1 + gap / PX_PER_BEAT;
  _started = true;
  return `--i:${_i++};--t:${tier};${beatsAttr(_beats)}`;
};

/** `top` is the card's own offset down its column, straight from the heights. */
const rvCard = (top: number) => {
  if (_gridStart === null) _gridStart = _beats + 1 + GAP.line / PX_PER_BEAT;
  const b = _gridStart + top / PX_PER_CARD_BEAT;
  _beats = Math.max(_beats, b);
  return `--i:${_i++};--t:5;--ci:${_ci++};${beatsAttr(b)}`;
};

/** Where each card starts down its column, so the grid can land by eye level. */
const cardTops = experimentColumns.map((column) => {
  let y = 0;
  return column.map((card) => {
    const top = y;
    y += card.height + CARD_GAP;
    return top;
  });
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eric Wang Design</title>
    <meta
      name="description"
      content="Eric Wang is a designer at Google Maps, working on navigation and cartography, thinking about how the world gets modeled and drawn, and in what order the information reaches the people moving through it."
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eric Wang" />
    <meta property="og:title" content="Eric Wang Design" />
    <meta
      property="og:description"
      content="Designer at Google Maps, working on navigation and cartography."
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="3220" />
    <meta property="og:image:height" content="1616" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Eric Wang Design" />
    <meta
      name="twitter:description"
      content="Designer at Google Maps, working on navigation and cartography."
    />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0f0f0f" />
    <link rel="icon" type="image/png" href="/favicon-darkbg.png" />
    <link rel="apple-touch-icon" href="/favicon-darkbg.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-latin-wght-normal.woff2"
      crossorigin
    />
    {
      /* The brush face is the one thing still fetched from Google: it is a
         handful of glyphs pulled with &text=, and only the footer needs it. */
      cjkInSignature && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={CJK_HREF} rel="stylesheet" />
        </>
      )
    }
    <Analytics piece="home" />
    <script is:inline>
      // Theme, before anything paints. Dark is the default. Light only if the device is light
      // and the person switched to light here before — a light choice on a dark device doesn't stick.
      (() => {
        let mode = "dark";
        try {
          const deviceLight = window.matchMedia && matchMedia("(prefers-color-scheme: light)").matches;
          if (deviceLight && localStorage.getItem("theme") === "light") mode = "light";
        } catch (e) {}
        document.documentElement.dataset.mode = mode;
      })();
    </script>
    <script is:inline define:vars={{ DEFAULT_ANIM }}>
      // Runs before first paint so the page never flashes visible, then hides.
      (function () {
        try {
          var url = new URL(window.location.href);
          var fromUrl = url.searchParams.get("anim");
          var stored = localStorage.getItem("ew.anim");
          var choice = fromUrl || stored || DEFAULT_ANIM;
          if (choice && choice !== "off") {
            document.documentElement.setAttribute("data-anim", choice);
          }
        } catch (e) {
          document.documentElement.setAttribute("data-anim", DEFAULT_ANIM);
        }
        // See the .settled rule in the stylesheet: this hands each element back
        // to the compositor the moment its entrance is done.
        document.addEventListener(
          "animationend",
          function (e) {
            var el = e.target;
            if (el.classList && el.classList.contains("rv")) {
              el.classList.add("settled");
            }
          },
          true,
        );
      })();
    </script>
  </head>
  <body>
    <!-- window light: sun through something — a window, blinds, leaves — falling across the page -->
    <div class="light" aria-hidden="true"></div>
    <div class="window" aria-hidden="true"><canvas id="light-canvas"></canvas></div>
    <aside class="lp closed" id="light-panel" aria-label="Light" data-dev={showPanel ? "1" : undefined} hidden>
      <button class="lp-head" id="lp-head" type="button" aria-expanded="false">
        <span>light & shadow</span><span class="lp-chev">▾</span>
      </button>
      <div class="lp-body">
        <div class="lp-shapes" id="lp-shapes">
          <button type="button" data-shape="window">window</button>
          <button type="button" data-shape="leaves">leaves</button>
        </div>
        <div class="lp-shapes" id="lp-panes" role="group" aria-label="Kind of window" hidden>
          <button type="button" data-pane="four">four panes</button>
          <button type="button" data-pane="tall">tall</button>
          <button type="button" data-pane="grid">grid</button>
          <button type="button" data-pane="arch">arch</button>
          <button type="button" data-pane="round">round</button>
          <button type="button" data-pane="blinds">blinds</button>
        </div>
        <div class="lp-shapes" id="lp-leaves" role="group" aria-label="Leaf variety" hidden>
          <button type="button" data-leaf="willow">willow</button>
          <button type="button" data-leaf="birch">birch</button>
          <button type="button" data-leaf="ginkgo">ginkgo</button>
          <button type="button" data-leaf="maple">maple</button>
          <button type="button" data-leaf="olive">olive</button>
          <button type="button" data-leaf="eucalyptus">eucalyptus</button>
          <button type="button" data-leaf="bamboo">bamboo</button>
        </div>
        <div class="lp-source" data-hourly><span id="lp-source">sunlight</span><span>24 hours</span></div>
        <label class="lp-row lp-hour" data-hourly><span>hour</span><input type="range" data-k="t" min="0" max="1" step="0.0006944444444444445" /><output></output></label>
        <label class="lp-row"><span>strength</span><input type="range" data-k="strength" min="0" max="1.5" step="0.05" /><output></output></label>
        <label class="lp-row"><span>softness</span><input type="range" data-k="soft" min="0" max="40" step="1" /><output></output></label>
        <label class="lp-row"><span>size</span><input type="range" data-k="scale" min="0.5" max="3" step="0.05" /><output></output></label>
        <label class="lp-row" data-only="leaves"><span>density</span><input type="range" data-k="density" min="0.5" max="2.5" step="0.1" /><output></output></label>
        <label class="lp-row" data-only="leaves"><span>speed</span><input type="range" data-k="breeze" min="0" max="3" step="0.05" /><output></output></label>
        <div class="lp-actions" data-only="leaves"><button type="button" id="lp-canopy">big soft canopy</button></div>
        <label class="lp-row"><span>lamp</span><input type="range" data-k="lamp" min="0" max="1" step="0.05" /><output></output></label>
        <div class="lp-actions"><button type="button" id="lp-follow" aria-pressed="false">lamp at mouse</button></div>
        <div class="lp-source" id="lp-motion" role="status">leaves swaying</div>
        <div class="lp-actions">
          <button type="button" id="lp-now" data-hourly>now</button>
          <button type="button" id="lp-reset">reset</button>
        </div>
      </div>
    </aside>
    <main>
      <div class="stack">
        <!-- intro -->
        <section class="intro">
          <div class="namerow">
            <p class="name rv" style={rvHead()}>Eric Wang</p>
            <button type="button" class="sw rv" id="theme-switch" aria-label="Switch to day" style={rvHead()}>
              <svg class="sun" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"/></svg>
              <svg class="moon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M13.6 9.9A5.6 5.6 0 0 1 6.1 2.4a5.6 5.6 0 1 0 7.5 7.5z"/></svg>
            </button>
          </div>

          <div class="bio">
            <p class="rv" style={rv(3, GAP.block)}>
              I'm a designer at <a
                class="u"
                href="https://www.google.com/maps"
                target="_blank"
                rel="noreferrer">Google Maps</a
              >, working on navigation and cartography, thinking about how the
              world gets modeled and drawn, and in what order the information
              reaches the people moving through it.
            </p>
            <p class="rv" style={rv(3, GAP.line)}>
              Before this, I designed at Tesla, did independent agency work helping
              startups grow from 0 to 1, and studied cognitive science at UC Berkeley.
            </p>
            <div class="loc rv" style={rv(3, GAP.block)}>
              <p id="loc-text">Recently spotted near <a class="u" href="https://www.google.com/maps/search/?api=1&query=San+Francisco%2C+CA" target="_blank" rel="noreferrer">San Francisco</a></p>
            </div>
          </div>
        </section>

        <!-- work -->
        <section class="section">
          <p class="label rv" style={rv(2, GAP.section)}>Work</p>
          {
            workGroups.map((group, g) => (
              <div class="group">
                <p class="company rv" style={rv(2, g === 0 ? GAP.block : GAP.group)}>
                  {group.company}
                </p>
                <div class="rows">
                  {group.items.map((item, n) => {
                    const Tag = item.href ? "a" : "div";
                    const external = item.href?.startsWith("http");
                    return (
                      <Tag
                        class:list={[
                          "row",
                          "rv",
                          { link: item.href, locked: item.locked },
                        ]}
                        href={item.href}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noreferrer" : undefined}
                        style={rv(4, n === 0 ? GAP.line : GAP.tight)}
                      >
                        <span class="title">{item.title}</span>
                        {item.href && (
                          <span class="arrow" aria-hidden="true">↗</span>
                        )}
                        {item.locked && (
                          <span class="lock" title="Not public yet">
                            <svg viewBox="0 0 12 12" width="14" height="14" aria-hidden="true">
                              <rect
                                x="2.4"
                                y="5.4"
                                width="7.2"
                                height="5.4"
                                rx="1.1"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.1"
                              />
                              <path
                                d="M4.2 5.4V3.9a1.8 1.8 0 0 1 3.6 0v1.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.1"
                                stroke-linecap="round"
                              />
                            </svg>
                          </span>
                        )}
                        <span class="year">{item.year}</span>
                      </Tag>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </section>

        <!-- experiments -->
        <section class="section">
          <p class="label rv" style={rv(2, GAP.section)}>Experiments</p>
          <div class="grid">
            {
              experimentColumns.map((column, c) => (
                <div class="col">
                  {column.map((card, n) => {
                    const Tag = card.href ? "a" : "div";
                    const isVideo = !!card.media && /\.(mp4|webm)$/i.test(card.media);
                    const livePreview =
                      !card.media && !!card.href && card.preview !== false;
                    const motion = !!card.media || livePreview;
                    return (
                      <Tag
                        class:list={[
                          "card",
                          "rv",
                          { link: card.href, motion, "day-live": card.liveInDay },
                        ]}
                        href={card.href}
                        style={`--h:${card.height};${rvCard(cardTops[c][n])}`}
                        data-title={card.title}
                        data-src={card.href}
                      >
                        {isVideo && (
                          <video
                            class="media"
                            src={card.media}
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                          />
                        )}
                        {card.media && !isVideo && (
                          <img class="media" src={card.media} alt="" />
                        )}
                        {livePreview && (
                          <iframe
                            class="preview"
                            data-preview={`${card.href}${card.href?.includes("?") ? "&" : "?"}chrome=off`}
                            title=""
                            aria-hidden="true"
                            tabindex="-1"
                            scrolling="no"
                            loading="lazy"
                          />
                        )}
                        {card.liveInDay && card.href && (
                          <iframe
                            class="preview day"
                            data-day={`${card.href}?chrome=off&paper=${DAY_BG}&night=${NIGHT_BG}`}
                            title=""
                            aria-hidden="true"
                            tabindex="-1"
                            scrolling="no"
                          />
                        )}
                        <div class:list={["caption", { end: card.alignEnd }]}>
                          <span class:list={[{ muted: card.muted }]}>
                            {card.title}
                          </span>
                          {card.date && <span class="date">{card.date}</span>}
                        </div>
                      </Tag>
                    );
                  })}
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <footer class="rv" style={rv(6, GAP.section)}>
        <p class="quote">{footerQuote.split(/([\u4e00-\u9fff]+)/).map((part) =>
            /[\u4e00-\u9fff]/.test(part) ? <span class="cjk">{part}</span> : part,
          )}</p>
        <div class="links">
          {
            footerLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            ))
          }
        </div>
      </footer>
    </main>

    <div class="viewer" id="viewer" hidden>
      <div class="viewer-scrim" data-close></div>
      <div class="viewer-win" role="dialog" aria-modal="true" aria-labelledby="viewer-title">
        <div class="viewer-bar">
          <button class="viewer-btn" id="viewer-close" type="button" aria-label="Close">
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
              <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
          <div class="viewer-name">
            <span id="viewer-title">Experiment</span>
            <a class="viewer-btn" id="viewer-open" href="#" target="_blank" rel="noreferrer" aria-label="Open full page">↗</a>
          </div>
          <span class="viewer-url" id="viewer-url"></span>
        </div>
        <iframe class="viewer-frame" id="viewer-frame" title="Experiment preview" />
      </div>
    </div>

    {
      showPanel && (
        <aside class="dev" id="dev-panel" aria-label="Entrance animation preview" hidden>
          <div class="dev-head">
            <span>entrance</span>
            <button class="dev-collapse" id="dev-collapse" type="button" aria-expanded="true">
              –
            </button>
          </div>
          <div class="dev-body" id="dev-body">
            {ANIMS.map((a, n) => (
              <button class="dev-opt" type="button" data-anim={a.id}>
                <span class="dev-n">{String(n + 1).padStart(2, "0")}</span>
                <span class="dev-l">
                  {a.label}
                  <em>{a.note}</em>
                </span>
              </button>
            ))}
            <button class="dev-opt" type="button" data-anim="off">
              <span class="dev-n">––</span>
              <span class="dev-l">
                Off<em>no animation</em>
              </span>
            </button>
            <div class="dev-sect" id="dev-tuner">
              <div class="dev-sect-h">curve</div>
              <div class="dev-tabs" id="dev-tabs">
                <button type="button" data-beat="name" aria-current="true">Name</button>
                <button type="button" data-beat="dither">Dither</button>
                <button type="button" data-beat="body">Body</button>
              </div>

              <div id="dev-bez">
                <svg class="dev-curve" id="dev-curve" viewBox="0 0 100 100" width="100%">
                  <rect x="0" y="0" width="100" height="100" class="c-box" />
                  <line x1="0" y1="100" x2="100" y2="0" class="c-diag" />
                  <line id="c-l1" class="c-hl" />
                  <line id="c-l2" class="c-hl" />
                  <path id="c-path" class="c-path" />
                  <circle id="c-p1" class="c-pt" r="5" />
                  <circle id="c-p2" class="c-pt" r="5" />
                </svg>
                <div class="dev-val" id="dev-bez-val">cubic-bezier(0.2, 0.8, 0.2, 1)</div>
                <div class="dev-presets" id="dev-presets">
                  <button type="button" data-bez="0,0,1,1">linear</button>
                  <button type="button" data-bez="0.2,0.8,0.2,1">smooth</button>
                  <button type="button" data-bez="0.16,1,0.3,1">expo</button>
                  <button type="button" data-bez="0.25,1,0.5,1">quart</button>
                  <button type="button" data-bez="0.34,1.56,0.64,1">back</button>
                  <button type="button" data-bez="0.4,0,0.2,1">soft</button>
                </div>
              </div>

              <div id="dev-steps" hidden>
                <label class="dev-slider">
                  <span>steps</span>
                  <input type="range" min="1" max="12" step="1" data-var="--sig-dither-steps" data-unit="" />
                  <em>4</em>
                </label>
                <p class="dev-hint">dither quantizes — no curve, just how many levels it lands on.</p>
              </div>

              <div class="dev-sect-h">timing</div>
              <label class="dev-slider">
                <span>name dur</span>
                <input type="range" min="120" max="1200" step="10" data-var="--sig-name-dur" data-unit="ms" />
                <em>420</em>
              </label>
              <label class="dev-slider">
                <span>dith start</span>
