    @media (max-width: 680px) { .dev { display: none; } }
        </style>
        <script is:inline>
          (function () {
            var panel = document.getElementById("dev-panel");
            if (!panel) return;
            var root = document.documentElement;

            // Stays hidden until asked for: ?dev in the URL, or ⌥D.
            try {
              if (
                new URL(location.href).searchParams.has("dev") ||
                localStorage.getItem("ew.dev") === "1"
              )
                panel.hidden = false;
            } catch (e) {}
            document.addEventListener("keydown", function (e) {
              if (!e.altKey || String(e.key).toLowerCase() !== "d") return;
              panel.hidden = !panel.hidden;
              try {
                localStorage.setItem("ew.dev", panel.hidden ? "0" : "1");
              } catch (err) {}
            });
            var options = Array.prototype.slice.call(
              panel.querySelectorAll(".dev-opt"),
            );
            function current() {
              return root.getAttribute("data-anim") || "off";
            }
            function mark() {
              var now = current();
              options.forEach(function (b) {
                b.setAttribute("aria-current", String(b.dataset.anim === now));
              });
            }
            function play(name) {
              root.removeAttribute("data-anim");
              Array.prototype.forEach.call(
                document.querySelectorAll(".rv.settled"),
                function (el) {
                  el.classList.remove("settled");
                },
              );
              void root.offsetWidth; // force reflow so the animation restarts
              if (name !== "off") root.setAttribute("data-anim", name);
              mark();
            }
            function choose(name) {
              try {
                localStorage.setItem("ew.anim", name);
              } catch (e) {}
              play(name);
            }
            options.forEach(function (b) {
              b.addEventListener("click", function () {
                choose(b.dataset.anim);
              });
            });
            var replay = document.getElementById("dev-replay");
            if (replay)
              replay.addEventListener("click", function () {
                play(current());
              });
            var collapse = document.getElementById("dev-collapse");
            if (collapse)
              collapse.addEventListener("click", function () {
                var closed = panel.classList.toggle("collapsed");
                collapse.setAttribute("aria-expanded", String(!closed));
                collapse.textContent = closed ? "+" : "–";
              });

            /* ---------- signature tuner ---------- */
            var DEFAULTS = {
              "--sig-name-dur": "520ms",
              "--sig-name-ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
              "--sig-dither-start": "380ms",
              "--sig-dither-stag": "30ms",
              "--sig-dither-dur": "380ms",
              "--sig-dither-steps": "4",
              "--sig-body-lead": "180ms",
              "--sig-body-stag": "28ms",
              "--sig-body-dur": "560ms",
              "--sig-body-ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
            };
            var EASE_VAR = { name: "--sig-name-ease", body: "--sig-body-ease" };
            var tune = {};
            try {
              tune = JSON.parse(localStorage.getItem("ew.sig") || "{}");
              if(localStorage.getItem("ew.sig.intro")!=="2") {
                ["--sig-name-dur","--sig-name-ease","--sig-body-lead","--sig-body-dur","--sig-body-ease","--sig-body-stag"].forEach(k=>delete tune[k]);
                localStorage.setItem("ew.sig",JSON.stringify(tune));
                localStorage.setItem("ew.sig.intro","2");
              }
            } catch (e) {}

            function readVar(k) {
              if (tune[k]) return tune[k];
              return DEFAULTS[k];
            }
            function setVar(k, v, persist) {
              tune[k] = v;
              root.style.setProperty(k, v);
              if (persist !== false) {
                try {
                  localStorage.setItem("ew.sig", JSON.stringify(tune));
                } catch (e) {}
              }
            }
            // push any stored overrides onto the document
            Object.keys(tune).forEach(function (k) {
              root.style.setProperty(k, tune[k]);
            });

            var beat = "name";
            var bez = { name: [0.2, 0.8, 0.2, 1], body: [0.2, 0.8, 0.2, 1] };
            ["name", "body"].forEach(function (b) {
              var m = String(readVar(EASE_VAR[b])).match(/-?[\d.]+/g);
              if (m && m.length === 4) bez[b] = m.map(Number);
            });

            var svg = document.getElementById("dev-curve");
            var p1 = document.getElementById("c-p1");
            var p2 = document.getElementById("c-p2");
            var l1 = document.getElementById("c-l1");
            var l2 = document.getElementById("c-l2");
            var path = document.getElementById("c-path");
            var bezVal = document.getElementById("dev-bez-val");
            var bezBox = document.getElementById("dev-bez");
            var stepBox = document.getElementById("dev-steps");
            var timeline = document.getElementById("dev-timeline");

            var toX = function (x) { return x * 100; };
            var toY = function (y) { return (1 - y) * 100; };

            /* persist=false during reset: drawCurve writes the curve back through
               setVar, so resetting used to clear localStorage and then instantly
               re-save the ease it had just cleared. */
            function drawCurve(persist) {
              if (beat === "dither") return;
              var b = bez[beat];
              var x1 = toX(b[0]), y1 = toY(b[1]), x2 = toX(b[2]), y2 = toY(b[3]);
              p1.setAttribute("cx", x1); p1.setAttribute("cy", y1);
              p2.setAttribute("cx", x2); p2.setAttribute("cy", y2);
              l1.setAttribute("x1", 0); l1.setAttribute("y1", 100);
              l1.setAttribute("x2", x1); l1.setAttribute("y2", y1);
              l2.setAttribute("x1", 100); l2.setAttribute("y1", 0);
              l2.setAttribute("x2", x2); l2.setAttribute("y2", y2);
              path.setAttribute(
                "d",
                "M 0 100 C " + x1 + " " + y1 + " " + x2 + " " + y2 + " 100 0",
              );
              var css =
                "cubic-bezier(" +
                b.map(function (n) { return Math.round(n * 100) / 100; }).join(", ") +
                ")";
              bezVal.textContent = css;
              setVar(EASE_VAR[beat], css, persist !== false);
            }

            var dragging = null;
            function pointToBez(evt) {
              var r = svg.getBoundingClientRect();
              var x = (evt.clientX - r.left) / r.width;
              var y = 1 - (evt.clientY - r.top) / r.height;
              return [
                Math.min(1, Math.max(0, x)),
                Math.min(1.6, Math.max(-0.6, y)),
              ];
            }
            [p1, p2].forEach(function (pt, idx) {
              pt.addEventListener("pointerdown", function (e) {
                dragging = idx;
                pt.setPointerCapture(e.pointerId);
                e.preventDefault();
              });
              pt.addEventListener("pointermove", function (e) {
                if (dragging !== idx) return;
                var v = pointToBez(e);
                bez[beat][idx * 2] = v[0];
                bez[beat][idx * 2 + 1] = v[1];
                drawCurve();
              });
              pt.addEventListener("pointerup", function () {
                if (dragging === idx) { dragging = null; play(current()); }
              });
            });

            document
              .getElementById("dev-presets")
              .addEventListener("click", function (e) {
                var b = e.target.closest("[data-bez]");
                if (!b || beat === "dither") return;
                bez[beat] = b.dataset.bez.split(",").map(Number);
                drawCurve();
                play(current());
              });

            var tabs = document.getElementById("dev-tabs");
            tabs.addEventListener("click", function (e) {
              var b = e.target.closest("[data-beat]");
              if (!b) return;
              beat = b.dataset.beat;
              Array.prototype.forEach.call(tabs.children, function (t) {
                t.setAttribute("aria-current", String(t.dataset.beat === beat));
              });
              var isDither = beat === "dither";
              bezBox.hidden = isDither;
              stepBox.hidden = !isDither;
              drawCurve();
            });

            var sliders = Array.prototype.slice.call(
              panel.querySelectorAll("input[type=range]"),
            );
            function syncTimeline() {
              var n = parseFloat(readVar("--sig-name-dur"));
              var ds = parseFloat(readVar("--sig-dither-start"));
              var dg = parseFloat(readVar("--sig-dither-stag"));
              var dd = parseFloat(readVar("--sig-dither-dur"));
              var chars = document.querySelectorAll(".handle .ch").length || 1;
              var dEnd = ds + (chars - 1) * dg + dd;
              var bl = parseFloat(readVar("--sig-body-lead"));
              var bg = parseFloat(readVar("--sig-body-stag"));
              var bd = parseFloat(readVar("--sig-body-dur"));
              // Beats are no longer one-per-element, so read the last one
              // off the page rather than counting nodes.
              var last = 0;
              Array.prototype.forEach.call(
                document.querySelectorAll(".rv"), function (el) {
                  var b = parseFloat(el.style.getPropertyValue("--b"));
                  if (b > last) last = b;
                },
              );
              var bEnd = bl + last * bg + bd;
              var gap = bl - dEnd;
              timeline.innerHTML =
                "name <b>0–" + Math.round(n) + "</b><br>" +
                "dither <b>" + Math.round(ds) + "–" + Math.round(dEnd) + "</b><br>" +
                "gap <b>" + (gap >= 0 ? "+" : "") + Math.round(gap) + "ms</b><br>" +
                "body <b>" + Math.round(bl) + "–" + Math.round(bEnd) + "</b>";
            }
            sliders.forEach(function (s) {
              var key = s.dataset.var;
              var unit = s.dataset.unit;
              s.value = parseFloat(readVar(key));
              s.nextElementSibling.textContent = s.value;
              s.addEventListener("input", function () {
                setVar(key, s.value + unit);
                s.nextElementSibling.textContent = s.value;
                syncTimeline();
              });
              s.addEventListener("change", function () { play(current()); });
            });

            document
              .getElementById("dev-copy")
              .addEventListener("click", function (e) {
                var css =
                  ":root {\n" +
                  Object.keys(DEFAULTS)
                    .map(function (k) { return "  " + k + ": " + readVar(k) + ";"; })
                    .join("\n") +
                  "\n}";
                navigator.clipboard.writeText(css).then(function () {
                  var b = e.target;
                  b.textContent = "✓";
                  setTimeout(function () { b.textContent = "Copy"; }, 900);
                });
                console.log(css);
              });

            document
              .getElementById("dev-reset")
              .addEventListener("click", function () {
                Object.keys(DEFAULTS).forEach(function (k) {
                  root.style.removeProperty(k);
                });
                tune = {};
                try { localStorage.removeItem("ew.sig"); } catch (e) {}
                bez = { name: [0.2, 0.8, 0.2, 1], body: [0.2, 0.8, 0.2, 1] };
                sliders.forEach(function (s) {
                  s.value = parseFloat(DEFAULTS[s.dataset.var]);
                  s.nextElementSibling.textContent = s.value;
                });
                drawCurve(false);
                syncTimeline();
                play(current());
              });

            drawCurve();
            syncTimeline();
            document.addEventListener("keydown", function (e) {
              if (e.key !== "Enter") return;
              var t = e.target;
              if (t && t.closest && t.closest("input, textarea")) return;
              play(current());
            });
            mark();
          })();
        </script>
      )
    }


    <style is:global>
      /* Geist is served from this origin rather than fonts.googleapis.com. The
         Google stylesheet was a render-blocking request to a third party on
         every page: two handshakes and a round trip before the first paint,
         to fetch a CSS file whose only job was to point at a woff2.
         One variable file covers 400 and 500. Italic is not shipped — the only
         <em> on the site is inside the dev-only tuner panel.
         Subset and unicode-range are @fontsource-variable/geist 5.3.0's own
         (see devDependencies); it deliberately omits the arrows ↗ and ←, which
         fall back to system-ui exactly as they did under the Google subset. */
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-display: swap;
        font-weight: 400 500;
        src: url("/fonts/geist-latin-wght-normal.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
          U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      /* Light palette — sketch for the theme switch. Pure neutral, to match the dark. */
      :root[data-mode="light"] {
        --bg: #f2f2f2;
        --card: #fafafa;
        --card-hover: #f3f3f3;
        --ink: #0f0f0f;
        --ink-2: #2e2e2e;
        --ink-3: #4a4a4a;
        --ink-4: #767676;
        --hair: rgba(0, 0, 0, 0.1);
      }

      :root {
        --bg: #0f0f0f;
        --card: #1a1a1a;
        --card-hover: #202020;
        --ink: #ffffff;
        --ink-2: #e6e6e6;
        --ink-3: #cccccc;
        --ink-4: #999999;
        --hair: rgba(255, 255, 255, 0.1);
        --sans: "Geist", system-ui, -apple-system, sans-serif;
        /* One typeface across the whole page — hierarchy comes from ink, not family. */
        --mono: ui-monospace, "SF Mono", Menlo, monospace;
        --cjk: "Liu Jian Mao Cao";

        /* Signature entrance — tunable live from the dev panel. */
        --sig-name-dur: 520ms;
        /* A gentler curve than the old (.2,.8,.2,1): that one rushed to nearly
           full opacity and then crawled, which reads as fast however long it
           runs. This spreads the change evenly, so things emerge instead of
           snapping and then waiting. */
        --sig-name-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
        --sig-dither-start: 380ms;
        --sig-dither-stag: 30ms;
        --sig-dither-dur: 380ms;
        --sig-dither-steps: 4;
        --sig-body-lead: 180ms;
        --sig-body-stag: 28ms;
        /* Each element's own blur has to finish faster than the beat that
           follows it, or the rhythm can't be heard: at 1200ms every line in a
           section was still resolving while the next section opened, and the
           column smeared into one long dissolve. Just under half that lets a
           section land before the next one starts. */
        --sig-body-dur: 560ms;
        --sig-body-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        /* 16/24 at a touch over regular: studied off benji.org, where the
           size is ordinary and the leading and weight do the work. */
        font-size: 16px;
        line-height: 24px;
        font-weight: 430;
        letter-spacing: -0.011em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* 640px column, 144px from the top, footer near the floor */
      main {
        min-height: 100svh;
        max-width: 680px; /* 640 + 20px padding each side */
        margin: 0 auto;
        padding: 144px 20px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 96px;
      }
      .stack {
        display: flex;
        flex-direction: column;
        gap: 72px;
      }

      /* ---------- intro ---------- */
      .intro {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .namerow {
        display: flex;
        align-items: flex-start;
        gap: 16px;
      }
      .name {
        margin: 0;
        flex: 1 0 0;
        min-width: 0;
        color: var(--ink);
      }
      .handle {
        margin: 0;
        width: 128px;
        flex-shrink: 0;
        letter-spacing: -0.01em;
        text-align: right;
        color: var(--ink-4);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .handle:hover { color: var(--ink-2); }
      .handle:focus-visible {
        outline: 1px solid var(--ink-4);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .bio {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .bio p {
        margin: 0;
        color: var(--ink-4);
      }
      /* Links carry one step more ink than the sentence, no underline. */
      a.u {
        color: var(--ink-3);
        cursor: pointer;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a.u:hover { color: var(--ink); }
      a.u:focus-visible {
        outline: 1px solid var(--ink-4);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .loc {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .loc p { margin: 0; color: var(--ink-4); }
      /* the theme switch: a sun by day, a moon by night, one turning into the other */
      .sw {
        position: relative; width: 17px; height: 17px; flex-shrink: 0;
        background: none; border: 0; padding: 0; cursor: pointer; color: var(--ink-4);
      }
      .sw:hover { color: var(--ink-2); }
      .sw:focus-visible { outline: 2px solid var(--ink-2); outline-offset: 3px; border-radius: 2px; }
      .sw svg { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .5s cubic-bezier(.4,0,.2,1), transform .5s cubic-bezier(.4,0,.2,1); }
      .sw .sun  { opacity: 0; transform: rotate(-90deg) scale(.6); }
      .sw .moon { opacity: 1; transform: none; }
      :root[data-mode="light"] .sw .sun  { opacity: 1; transform: none; }
      :root[data-mode="light"] .sw .moon { opacity: 0; transform: rotate(90deg) scale(.6); }
      .namerow .sw { margin-left: auto; align-self: center; }

      /* ---------- sections ---------- */
      .section {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .label {
        margin: 0;
        color: var(--ink-2);
      }

      /* ---------- work ---------- */
      .group {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 8px;
      }
      .company {
        position: relative;
        margin: 0;
        padding-top: 10px;
        color: var(--ink-3);
      }
      .company::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--hair);
        transform-origin: left center;
      }
      /* No gap between rows: the 16px sits inside each row as padding instead,
         with the container pulled back 8px top and bottom. Geometry is identical
         to a 16px gap, but the rows now tile with no dead space between them —
         so moving down the list never passes through a gap where nothing is
         hovered, which is what made the dimming flicker. */
      .rows {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: -8px 0;
      }
      .row {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 0 8px 16px;
        color: var(--ink-4);
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 0.15s ease, color 0.15s ease;
      }
      .row .title { flex-shrink: 0; }
      .row .year {
        margin-left: auto;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }
      .row .arrow,
      .row .lock {
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease;
      }
      .row .lock {
        display: inline-flex;
        align-items: center;
        line-height: 0;
        cursor: help;
      }
      .row.link { cursor: pointer; }
      .row.locked { cursor: default; }
      .row.link:focus-visible {
        outline: 1px solid var(--ink-4);
        outline-offset: 3px;
        border-radius: 2px;
      }
      /* Hovering one row dims its siblings and brings the hovered one forward.
         Keyed on :has(.row:hover) rather than .rows:hover — the 12px gaps between
         rows belong to .rows but to no .row, so a plain :hover dimmed every row
         with none left to highlight whenever the pointer sat in the spacing. */
      @media (hover: hover) and (pointer: fine) {
        .rows:has(.row:hover) .row { opacity: 0.3; }
        .rows:has(.row:hover) .row:hover { opacity: 1; }
        .row:hover { color: var(--ink-2); }
        .row.link:hover .arrow,
        .row.locked:hover .lock { opacity: 1; transform: translateX(0); }
        /* the padlock reads as a "no" — keep it quieter than the arrow */
        .row.locked:hover .lock { opacity: 0.55; }
      }

      /* ---------- experiments ---------- */
      .grid {
        display: flex;
        align-items: flex-start;
        gap: 8px;
      }
      .col {
        flex: 1 0 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .card {
        position: relative;
        /* Height as a ratio of the 316px design column rather than fixed px, so
           the masonry scales fluidly instead of collapsing at a breakpoint.
           324+316 and 240+400 both make 640, so the columns stay flush at any
           width. */
        aspect-ratio: 316 / var(--h);
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        padding: 8px;
        border-radius: 8px;
        background: var(--card);
        color: var(--ink);
        text-decoration: none;
      }
      .card .media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* A live, scaled-down render of the experiment itself. Four times the card
         size then scaled to a quarter, so the page lays out at desktop width. */
      .card .preview {
        position: absolute;
        top: 0;
        left: 0;
        width: 400%;
        height: 400%;
        border: 0;
        transform: scale(0.25);
        transform-origin: 0 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .card .preview.ready { opacity: 1; }
      /* Day mode. A recording shot in the dark can't be relit, so the tile runs
         the piece itself at its real size, and you can push it around. It is
         mounted and parked (display: none, so it costs nothing) until day, and
         crossfades with the recording on the page's own curve, so both tiles
         turn with the page rather than after it. */
      .card .preview.day {
        width: 100%;
        height: 100%;
        transform: none;
        transition: opacity 0.7s cubic-bezier(.4, 0, .2, 1);
      }
      .card .preview.day.on { opacity: 1; pointer-events: auto; }
      .card .preview.day.parked { display: none; }
      /* On a phone the tile is as wide as the screen and the piece takes every touch
         (touch-action: none), so a thumb landing on it could no longer scroll the
         page. There it is something to look at; a tap opens it like any other tile. */
      @media (pointer: coarse) {
        .card .preview.day.on { pointer-events: none; }
      }
      /* A live tile has no colour of its own, night or day: it sits on the page and
         the divider's hairline gives it an edge by day (never at night), so the window light crosses it
         the way it crosses everything else. The pieces draw on transparency (or,
         Water, in the page's colour), which also means a tile turns with the page
         exactly — there is one colour changing, not two layers trading places.
         The recording was shot on black; screened, its black is the page. */
      .card.motion { background: var(--bg); }
      .card.motion .media { mix-blend-mode: screen; }
      :root[data-mode="light"] .card.motion::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        pointer-events: none;
        box-shadow: inset 0 0 0 1px var(--hair);
      }
      .caption {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        font-size: 15px;
        line-height: 1;
        white-space: nowrap;
      }
      .caption.end { justify-content: flex-end; }
      .caption .muted { opacity: 0.6; }
      .caption .date { opacity: 0.6; }
      /* Motion cards keep the name off until you point at them. */
      .card.motion .caption {
        opacity: 0;
        transform: translateY(3px);
        transition: opacity 0.18s ease, transform 0.18s ease;
      }
      .card.motion::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 46%;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.62));
        opacity: 0;
        transition: opacity 0.18s ease;
        pointer-events: none;
      }
      :root[data-mode="light"] .card.motion::after {
        background: linear-gradient(rgba(242, 242, 242, 0), rgba(242, 242, 242, 0.86));
      }
      :root:not([data-mode="light"]) .card.motion::after {
        background: linear-gradient(rgba(15, 15, 15, 0), rgba(15, 15, 15, 0.8));
      }
      .card.motion:hover .caption,
      .card.motion:focus-visible .caption {
        opacity: 1;
        transform: translateY(0);
      }
      .card.motion:hover::after,
      .card.motion:focus-visible::after { opacity: 1; }
      .card.link { cursor: pointer; transition: background-color 0.15s ease; }
      .card.link:not(.motion):hover { background: var(--card-hover); }
      .card.link:focus-visible {
        outline: 1px solid var(--ink-4);
        outline-offset: 2px;
      }

      /* ---------- experiment viewer ---------- */
      .viewer[hidden] { display: none; }
      .viewer {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .viewer-scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(3px);
        animation: v-fade 0.2s ease both;
      }
      .viewer-win {
        position: relative;
        display: flex;
        flex-direction: column;
        width: min(1120px, 100%);
        height: min(760px, 100%);
        border-radius: 10px;
        overflow: hidden;
        background: var(--card);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
        animation: v-in 0.26s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      @keyframes v-fade { from { opacity: 0; } }
      @keyframes v-in { from { opacity: 0; transform: translateY(10px) scale(0.985); } }
      .viewer-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        padding: 7px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        background: rgba(255, 255, 255, 0.02);
        flex-shrink: 0;
      }
      .viewer-name {
        display: flex;
        align-items: center;
        gap: 7px;
        justify-content: center;
        color: var(--ink-2);
        white-space: nowrap;
      }
      .viewer-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: var(--ink-4);
        cursor: pointer;
        text-decoration: none;
        flex-shrink: 0;
      }
      .viewer-btn:hover { background: rgba(255, 255, 255, 0.09); color: var(--ink); }
      .viewer-btn:focus-visible { outline: 1px solid var(--ink-4); outline-offset: 1px; }
      #viewer-close { justify-self: start; }
      .viewer-url {
        justify-self: end;
        color: #5c5c5c;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .viewer-frame {
        flex: 1;
        width: 100%;
        border: 0;
        background: var(--bg);
      }
      body.viewer-open { overflow: hidden; }
      @media (max-width: 680px) {
        .viewer { padding: 0; }
        .viewer-win { width: 100%; height: 100%; border-radius: 0; border: 0; }
        .viewer-url { display: none; }
      }

      /* ---------- footer ---------- */
      footer {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }
      .quote {
        margin: 0;
        flex: 1 0 0;
        min-width: 0;
        color: var(--ink-3);
      }
      /* The brush face runs large for its point size, so pull it back to sit
         on the same visual line as the Latin around it. */
      .quote .cjk {
        font-family: var(--cjk), var(--sans);
        font-size: 0.92em;
        letter-spacing: 0.02em;
      }
      .links {
        display: flex;
        gap: 12px;
        flex-shrink: 0;
        white-space: nowrap;
      }
      .links a {
        color: var(--ink-4);
        text-decoration: none;
      }
      .links a:hover { color: var(--ink); }
      .links a:focus-visible {
        outline: 1px solid var(--ink-4);
        outline-offset: 2px;
        border-radius: 2px;
      }

      /* =====================================================
         Entrance animations
         Base state is the finished state, so with JS off or
         no [data-anim] the page simply renders. Each keyframe
         set only declares `from`; the browser fills `to` with
         the element's natural values.
         ===================================================== */
      html[data-anim] .rv {
        animation-duration: var(--dur, 0.55s);
        animation-timing-function: var(--ease, cubic-bezier(0.2, 0.8, 0.2, 1));
        /* Not `both`. iOS Safari keeps a composited layer alive for as long as
           an animation is still applying values, and the text in that layer
           stays rasterized at the resolution it had while blurred — so a
           forwards fill left whole paragraphs permanently soft on iPhone long
           after they had "finished". Every keyframe set here only declares
           `from`, so the finished state is just the element's own style and
           there is nothing for a forwards fill to hold anyway. */
        animation-fill-mode: backwards;
        animation-delay: calc(var(--i, 0) * var(--stag, 26ms) + var(--lead, 0ms));
      }
      /* Belt and braces for the same bug: drop the animation outright as each
         element lands, so no layer is left compositing even mid-run. */
      html[data-anim] .rv.settled,
      html[data-anim] .rv.settled .ch {
        animation: none;
      }

      @keyframes a-fadeup { from { opacity: 0; transform: translateY(8px); } }
      @keyframes a-blurup { from { opacity: 0; filter: blur(8px); transform: translateY(16px); } }
      @keyframes a-fade { from { opacity: 0; } }
      @keyframes a-tile { from { opacity: 0; transform: scale(0.96); } }
      @keyframes a-settle { from { opacity: 0; transform: scale(0.985); } }
      @keyframes a-track { from { opacity: 0; letter-spacing: 0.06em; } }
      @keyframes a-ink {
        from { opacity: 0.5; -webkit-mask-size: 100% 0%; mask-size: 100% 0%; }
        to { opacity: 1; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
      }
      @keyframes a-line { from { transform: scaleX(0); } }

      @keyframes a-intro {
        from { opacity: 0; transform: translateY(6px); filter: blur(3px) brightness(var(--light-brightness, 1)); }
      }
      /* Name and switch arrive together; the bio overlaps their gentle settle. */
      html[data-anim="signature"] .rv {
        animation-name: a-blurup;
        /* --b is the beat this element lands on, and a beat is a distance:
           see the reveal bookkeeping above. The name and the handle are timed
           separately just below. */
        animation-delay: calc(
          var(--sig-body-lead) + var(--b, 0) * var(--sig-body-stag)
        );
        animation-duration: var(--sig-body-dur);
        animation-timing-function: var(--sig-body-ease);
      }
      html[data-anim="signature"] .intro .rv { animation-name: a-intro; }
      html[data-anim="signature"] .name,
      html[data-anim="signature"] #theme-switch {
        animation: a-fadeup var(--sig-name-dur) var(--sig-name-ease) backwards;
        animation-delay: 0ms;
      }
      html[data-anim="signature"] .handle {
        animation: none;
        opacity: 1;
      }
      html[data-anim="signature"] .handle .ch {
        animation: a-fade var(--sig-dither-dur)
          steps(var(--sig-dither-steps), end) both;
        animation-delay: calc(
          var(--sig-dither-start) + var(--s, 0) * var(--sig-dither-stag)
        );
      }

      /* 01 fade up */
      html[data-anim="fade-up"] .rv { animation-name: a-fadeup; }

      /* 02 blur up */
      html[data-anim="blur-up"] .rv {
        animation-name: a-blurup;
        --stag: 34ms;
        --dur: 0.7s;
      }

      /* 03 cascade — every line, quickly, in document order */
      html[data-anim="cascade"] .rv {
        animation-name: a-fadeup;
        --stag: 16ms;
        --dur: 0.4s;
      }

      /* 04 progressive — ordered by hierarchy tier, not by position */
      html[data-anim="progressive"] .rv {
        animation-name: a-fadeup;
        animation-delay: calc(var(--t, 1) * 95ms);
        --dur: 0.6s;
      }

      /* 05 map settle — the column eases out of a zoom as one object */
      html[data-anim="map-settle"] main {
        animation: a-settle 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      html[data-anim="map-settle"] .rv { animation: none; }

      /* 06 ink bleed — content wipes downward */
      html[data-anim="ink-bleed"] .rv {
        animation-name: a-ink;
        -webkit-mask-image: linear-gradient(#000, #000);
        mask-image: linear-gradient(#000, #000);
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: top left;
        mask-position: top left;
        --stag: 30ms;
        --dur: 0.5s;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
      }

      /* 07 dither resolve — quantized, like a halftone finding its level */
      html[data-anim="dither"] .rv {
        animation-name: a-fade;
        --stag: 26ms;
        --dur: 0.6s;
        --ease: steps(6, end);
      }

      /* 08 hairline draw — rules draw first, then the text arrives */
      html[data-anim="hairline"] .company::before {
        animation: a-line 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        animation-delay: calc(var(--i, 0) * 26ms);
      }
      html[data-anim="hairline"] .rv {
        animation-name: a-fade;
        --stag: 22ms;
        --lead: 260ms;
        --dur: 0.5s;
      }

      /* 09 tiles first — the work lands before the words */
      html[data-anim="tiles-first"] .rv {
        animation-name: a-fadeup;
        --stag: 20ms;
        --lead: 300ms;
      }
      html[data-anim="tiles-first"] .rv.card {
        animation-name: a-tile;
        animation-delay: calc(var(--ci, 0) * 55ms);
        --dur: 0.6s;
      }

      /* 10 type settle — tracking tightens as it fades in */
      html[data-anim="type-settle"] .rv {
        animation-name: a-track;
        --stag: 28ms;
        --dur: 0.7s;
      }

      @media (prefers-reduced-motion: reduce) {
        html[data-anim] .rv,
        html[data-anim] main,
        html[data-anim] .name,
        html[data-anim] .handle .ch,
        html[data-anim] .company::before {
          animation: none !important;
        }
        .card.link, .row, .row .arrow { transition: none; }
      }

      /* ---------- responsive ---------- */
      @media (max-width: 680px) {
        main { padding: 64px 16px 40px; gap: 48px; }
        .stack { gap: 48px; }
        .namerow { justify-content: space-between; }
        .name { flex: 0 1 auto; }
        .handle { width: auto; text-align: right; }
        /* two columns stay — the grid shrinks, it does not stack */
        .row { white-space: normal; gap: 12px; }
      }

    </style>

    <script>
      // ---- live location line: city follows the Pacific-time clock -------
      // 9am–8pm Pacific reads as San Francisco (where the work is); outside
      // that window it reads as Oakland, CA — home, at night.
      type CitySpec = { name: string; lat: number; lon: number };
      const SF: CitySpec = { name: "San Francisco", lat: 37.7749, lon: -122.4194 };
      const OAKLAND: CitySpec = { name: "Oakland", lat: 37.8044, lon: -122.2711 };

      function pacificHour(): number | null {
        const hour = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Los_Angeles",
          hour: "numeric",
          hour12: false,
        })
          .formatToParts(new Date())
          .find((p) => p.type === "hour")?.value;
        return hour ? parseInt(hour, 10) % 24 : null;
      }

      /** A Maps search for the city — the one link on the page that is the day job. */
      function mapsUrl(city: CitySpec) {
        return (
          "https://www.google.com/maps/search/?api=1&query=" +
          encodeURIComponent(`${city.name}, CA`)
        );
      }

      /** Built as nodes rather than innerHTML so the city name is never parsed as markup. */
      function render(el: HTMLElement, lead: string, city: CitySpec, tail = "") {
        const link = document.createElement("a");
        link.className = "u";
        link.href = mapsUrl(city);
        link.target = "_blank";
        link.rel = "noreferrer";
        link.textContent = city.name;
        el.replaceChildren(lead, link, tail);
      }

      /** One word for the sky, from the WMO weather code and the wind. */
      function skyWord(code: number, mph: number): string {
        if (code === 45 || code === 48) return "foggy";
        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return "raining";
        if ((code >= 71 && code <= 77) || code >= 85 && code <= 86) return "snowing";
        if (code >= 95) return "stormy";
        if (mph >= 14) return "windy";
        if (mph >= 7) return "breezy";
        if (code === 0) return "clear";
        if (code === 1) return "mostly clear";
        return "cloudy";
      }

      async function loadWeather() {
        const el = document.getElementById("loc-text");
        if (!el) return;
        const hour = pacificHour();
        const city = hour === null || (hour >= 9 && hour < 20) ? SF : OAKLAND;
        try {
          const res = await fetch(
            `https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,wind_speed_10m,weather_code&temperature_unit=fahrenheit&wind_speed_unit=mph`,
          );
          if (!res.ok) return;
          const data = await res.json();
          const temp = Math.round(data?.current?.temperature_2m);
          if (!Number.isFinite(temp)) return;
          const sky = skyWord(Number(data?.current?.weather_code ?? -1), Number(data?.current?.wind_speed_10m ?? 0));
          render(el, "Recently spotted near ", city, `, where it's ${temp}° and ${sky}`);
        } catch {
          render(el, "Recently spotted near ", city); // still swap the city even if the fetch fails
        }
      }
      loadWeather();

      // ---- card previews: only mount an iframe once the tile is in view ----
      const frames = Array.from(
        document.querySelectorAll<HTMLIFrameElement>("iframe[data-preview]"),
      );
      if (frames.length) {
        const mount = (f: HTMLIFrameElement) => {
          if (f.dataset.mounted) return;
          f.dataset.mounted = "1";
          f.addEventListener("load", () => f.classList.add("ready"), { once: true });
          // a tile that knows about day and night starts in the page's mode
          const day = document.documentElement.dataset.mode === "light";
          f.src = f.dataset.preview! + (day ? "&mode=light" : "");
        };
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                mount(e.target as HTMLIFrameElement);
                io.unobserve(e.target);
              });
            },
            { rootMargin: "200px" },
          );
          frames.forEach((f) => io.observe(f));
        } else {
          frames.forEach(mount);
        }
      }

      // ---- tiles follow day and night ----------------------------------
      // Live previews are told the mode and tween their own palette; a tile
      // with a night-only recording swaps it for the running piece by day.
      {
        const root = document.documentElement;
        const dayFrames = Array.from(
          document.querySelectorAll<HTMLIFrameElement>("iframe[data-day]"),
        );
        let parting: number | undefined;
        const syncTiles = () => {
          const mode = root.dataset.mode === "light" ? "light" : "dark";
          frames.forEach((f) => {
            if (f.dataset.mounted)
              f.contentWindow?.postMessage({ ewMode: mode }, location.origin);
          });
          clearTimeout(parting);
          dayFrames.forEach((f) => {
            const video = f.parentElement?.querySelector("video");
            f.contentWindow?.postMessage({ ewMode: mode }, location.origin);
            if (mode === "light") {
              f.classList.remove("parked");
              void f.offsetWidth; // so the fade starts from 0, not from nothing
              f.classList.add("on");
              // covered once the fade lands; no need to keep decoding under it
              parting = window.setTimeout(() => video?.pause(), 760);
            } else {
              f.classList.remove("on");
              video?.play().catch(() => {});
              // once it has faded, park it: a hidden frame stops drawing
              parting = window.setTimeout(() => f.classList.add("parked"), 760);
            }
          });
        };
        // loaded ahead of time, so day has nothing to wait for
        dayFrames.forEach((f) => {
          if (root.dataset.mode !== "light") f.classList.add("parked");
          f.src = f.dataset.day!;
        });
        new MutationObserver(syncTiles).observe(root, {
          attributes: true,
          attributeFilter: ["data-mode"],
        });
        [...frames, ...dayFrames].forEach((f) => f.addEventListener("load", syncTiles));
        syncTiles();
      }

      // ---- experiment viewer -------------------------------------------
      const viewer = document.getElementById("viewer");
      const vFrame = document.getElementById("viewer-frame") as HTMLIFrameElement | null;
      const vTitle = document.getElementById("viewer-title");
      const vOpen = document.getElementById("viewer-open") as HTMLAnchorElement | null;
      const vUrl = document.getElementById("viewer-url");
      const vClose = document.getElementById("viewer-close");

      if (viewer && vFrame && vTitle && vOpen && vUrl && vClose) {
        let lastFocused: HTMLElement | null = null;

        // Hand the keyboard to the experiment, not to the chrome. Focusing
        // the close button (as this used to) meant the first thing a visitor
        // typed went nowhere — and Space or Enter dismissed the viewer
        // outright. These previews are things you type into.
        function focusFrame() {
          if (viewer!.hidden) return; // closed again before it loaded
          vFrame!.focus({ preventScroll: true });
          try {
            const doc = vFrame!.contentDocument;
            // Escape must keep working even though focus now lives inside
            // the frame, where the parent's own keydown listener can't see
            // it. The embedded page gets first refusal: if it handled the
            // key (called preventDefault), the viewer stays put.
            doc?.addEventListener("keydown", (e) => {
              if (e.key === "Escape" && !e.defaultPrevented) closeViewer();
            });
          } catch {
            /* cross-origin frame: it still takes focus, Escape just won't reach us */
          }
        }

        function openViewer(src: string, title: string) {
          lastFocused = document.activeElement as HTMLElement;
          vTitle!.textContent = title;
          vOpen!.href = src;
          vUrl!.textContent = location.host + src;
          vFrame!.addEventListener("load", focusFrame, { once: true });
          vFrame!.src = src;
          viewer!.hidden = false;
          document.body.classList.add("viewer-open");
        }

        function closeViewer() {
          if (viewer!.hidden) return;
          viewer!.hidden = true;
          vFrame!.removeAttribute("src"); // stop whatever was running inside
          document.body.classList.remove("viewer-open");
          lastFocused?.focus();
        }

        document.querySelectorAll<HTMLAnchorElement>("a.card[data-src]").forEach((card) => {
          card.addEventListener("click", (e) => {
            // let cmd/ctrl/middle-click fall through to a real navigation
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
            e.preventDefault();
            openViewer(card.dataset.src!, card.dataset.title || "Experiment");
          });
        });

        // A live tile takes its own pointer, so it can't be clicked like a
        // link. It asks instead: a still tap on its empty surface opens it.
        window.addEventListener("message", (e) => {
          if (e.origin !== location.origin || !e.data?.ewOpen) return;
          const card = document.querySelector<HTMLAnchorElement>(
            `a.card[data-title="${CSS.escape(String(e.data.ewOpen))}"]`,
          );
          if (card) openViewer(card.dataset.src!, card.dataset.title || "Experiment");
        });

        vClose.addEventListener("click", closeViewer);
        viewer.querySelector("[data-close]")?.addEventListener("click", closeViewer);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeViewer();
        });
      }

    </script>
    <!-- ---- theme switch: a calm crossfade between night and day ---- -->
    <style is:global>
      /* While a switch is in flight, every colour on the page eases together. */
      html.theming, html.theming *, html.theming *::before, html.theming *::after {
        transition-property: background-color, color, border-color, fill, stroke, box-shadow, text-decoration-color !important;
        transition-duration: .7s !important;
        transition-timing-function: cubic-bezier(.4, 0, .2, 1) !important;
      }
      /* The rule above takes opacity off everything while the page turns, which made
         the Water tile snap while the rest faded. Its recording and its live frame
         trade places on opacity, so they keep it — same duration and curve. */
      html.theming .card .preview.day { transition-property: opacity !important; }
      html.theming .sw svg { transition-property: opacity, transform !important; transition-duration: .5s !important; }
    </style>
    <script is:inline>
    (() => {
      const root = document.documentElement;
      const sw = document.getElementById("theme-switch");
      if (!sw) return;
      if (!root.dataset.mode) root.dataset.mode = "dark";
      const RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const device = matchMedia("(prefers-color-scheme: dark)");
      let busy = false;
      const saved = () => { try { return localStorage.getItem("theme"); } catch (e) { return null; } };
      function apply(mode) {
        root.dataset.mode = mode;
        sw.setAttribute("aria-label", mode === "dark" ? "Switch to day" : "Switch to night");
      }
      function fade(to) {
        if (RM || root.dataset.mode === to) { apply(to); return; }
        busy = true;
        root.classList.add("theming");
        requestAnimationFrame(() => requestAnimationFrame(() => {
          apply(to);
          setTimeout(() => { root.classList.remove("theming"); busy = false; }, 760);
        }));
      }
      apply(root.dataset.mode);
      sw.addEventListener("click", () => {
        if (busy) return;
        const to = root.dataset.mode === "dark" ? "light" : "dark";
        try { localStorage.setItem("theme", to); } catch (e) {}
        fade(to);
      });
      // The device setting changed while the page was open. Dark device: dark. Light device: light
      // only if light was chosen here.
      device.addEventListener("change", (e) => {
        if (busy) return;
        fade(e.matches ? "dark" : (saved() === "light" ? "light" : "dark"));
      });
    })();
    </script>

    <!-- ---- window light ---- -->
    <style is:global>
      /* Over the page, like real light — it falls on the cards too — but under
         the experiment viewer (40) and the panels (50). Two layers: a faint
         ambient dim for the room (multiply) and the light itself (screen). */
      .light, .window {
        position: fixed;
        inset: 0;
        z-index: 30;
        pointer-events: none;
        overflow: hidden;
      }
      .light { mix-blend-mode: multiply; }
      .window { mix-blend-mode: screen; transition: opacity 1.2s ease; }
      :root[data-mode="light"] .window { mix-blend-mode: multiply; }
      .window canvas { width: 100%; height: 100%; display: block; }

      /* A fine warm edge and a restrained bloom, sampled from the light canvas. */
      .light-receiver {
        filter: brightness(var(--light-brightness, 1));
        text-shadow: 0 .35px .6px rgba(246, 228, 190, var(--light-rim, 0)),
          0 0 3px rgba(245, 225, 185, var(--light-glow, 0));
      }
      @media (forced-colors: active) {
        .light-receiver { filter: none; text-shadow: none; }
      }

      /* ---------- light panel ---------- */
      .lp[hidden], .lp [hidden] { display: none !important; }
      .lp {
        position: fixed;
        left: 16px;
        bottom: 16px;
        z-index: 50;
        width: 220px;
        background: rgba(24, 24, 22, .88);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0;
        color: #999;
        overflow: hidden;
      }
      .lp button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
      .lp-head {
        display: flex; justify-content: space-between; width: 100%;
        padding: 8px 10px; color: #e6e6e6 !important;
      }
      .lp-chev { transition: transform .2s; }
      .lp.closed .lp-chev { transform: rotate(-90deg); }
      .lp.closed .lp-body { display: none; }
      .lp.closed { width: 196px; }
      .lp-body { padding: 0 10px 10px; display: flex; flex-direction: column; gap: 8px; }
      .lp-shapes { display: flex; flex-wrap: wrap; gap: 4px; }
      .lp-shapes button {
        padding: 4px 7px; border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
      }
      .lp-shapes button:hover { color: #e6e6e6; }
      .lp-shapes button[aria-pressed="true"] { background: #e6e6e6; color: #141414; }
      .lp-row { display: grid; grid-template-columns: 58px 1fr 30px; align-items: center; gap: 6px; }
      .lp-source { display: flex; justify-content: space-between; color: #aaa; font-size: 10px; padding-top: 4px; }
      .lp-hour { grid-template-columns: 30px 1fr 58px; }
      .lp-hour output { white-space: nowrap; color: #aaa; }
      .lp-row input { width: 100%; accent-color: #e6e6e6; margin: 0; }
      .lp-row output { text-align: right; color: #666; }
      .lp-actions { display: flex; gap: 4px; }
      .lp-actions button {
        flex: 1; padding: 4px; border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
      }
      .lp-actions button[aria-pressed="true"] { background: #ded9cc; color: #171715; }
      .lp-actions button:hover { color: #e6e6e6; }
    </style>
    <script>
      import "../scripts/atmosphere.js";
    </script>

  </body>
</html>
