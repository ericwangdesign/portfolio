---
/**
 * Every page's analytics in one line. The real work lives in `public/track.js`
 * so the standalone .html pieces — which aren't Astro components — can include
 * the exact same file and land in the same dashboard.
 *
 * Clarity project `xprgtw49pv` (clarity.microsoft.com) plus Vercel Web
 * Analytics. See track.js for what gets reported and why.
 */
interface Props {
  /** Event prefix for this page. Defaults to the pathname. */
  piece?: string;
}
const { piece } = Astro.props;
---

<script is:inline defer src="/track.js" data-piece={piece}></script>
